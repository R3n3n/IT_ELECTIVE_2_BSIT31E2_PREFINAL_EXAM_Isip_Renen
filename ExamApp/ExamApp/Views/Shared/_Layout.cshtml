<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IT Elective 2 Prefinal Exam</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="site-header">
        <div class="container">
            <span class="badge">IT ELECTIVE 2</span>
            <h1>Prefinal Exam &mdash; MVC Answer Booklet</h1>
            <p class="subtitle">Renen Isip &bull; BSIT 31E2</p>
        </div>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <p>Built with ASP.NET Core MVC &bull; No database used &bull;</p>
        </div>
    </footer>
</body>
</html>